# BESS Agent environment variables configuration example
# Copy this file to .env and fill in actual values
# Note: .env file should not be committed to Git

# InfluxDB Configuration
# URL: InfluxDB server URL (default: http://localhost:8086)
INFLUXDB_URL=http://localhost:8086
# Token: API token for authentication (required)
# Get token from: docker logs bess-influxdb | grep -i token
# Or from InfluxDB UI: http://localhost:8086 → Data → Tokens
# Default (dev only): changeme
INFLUXDB_TOKEN=your_influxdb_token_here
# Organization: InfluxDB organization name (default: bess)
INFLUXDB_ORG=bess
# Bucket: InfluxDB bucket name for storing data (default: alarms)
INFLUXDB_BUCKET=alarms

# PostgreSQL
DB_USER=bess_agent
DB_PASSWORD=your_db_password_here

# JWT Authentication Configuration
# Secret Key: Used to sign and verify JWT tokens (REQUIRED for production)
# Generate a secure key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Never commit this key to Git! Use a different key for each environment.
JWT_SECRET_KEY=your_jwt_secret_key_here
# Token Expiration: Access token expiration time in minutes (default: 1440 = 24 hours)
# Recommended: 60-120 minutes for production, 1440 for development
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email Verification Code Configuration
# Expiration: Verification code expiration time in minutes (default: 10 minutes)
VERIFICATION_CODE_EXPIRE_MINUTES=10
# Rate Limit: Minimum minutes between verification code requests (default: 1 minute)
VERIFICATION_CODE_RATE_LIMIT_MINUTES=1

# Redis Configuration
# Host: Use "redis" when running in Docker, "localhost" when running locally
REDIS_HOST=localhost  # Use "redis" for Docker Compose, "localhost" for local development
REDIS_PORT=6379
REDIS_PASSWORD=changeme  # Default password, change in production
REDIS_DB=0

# LLM API configuration (choose one to use)
# Groq API (recommended for MVP, free)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (production environment)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Gemini API (free quota)
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face API (free quota)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Together AI API (free quota)
TOGETHER_API_KEY=your_together_api_key_here

# Grafana
GRAFANA_API_KEY=your_grafana_api_key_here

# Webhook Authentication (choose one method)
# Method 1: API Key authentication (recommended for simple setups)
WEBHOOK_API_KEY=your_webhook_api_key_here
# Method 2: Signature-based authentication (for Grafana webhooks)
# WEBHOOK_SECRET=your_webhook_secret_here

# Email Service Configuration (SMTP)
# Required for sending verification codes and alarm notifications
# 
# Common SMTP providers:
# 
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_app_password  # Use App Password, not regular password
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#   FROM_ADDRESS=your_email@gmail.com
#   FROM_NAME=BESS Agent
#
# Outlook/Hotmail:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@outlook.com
#   SMTP_PASSWORD=your_password
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#
# QQ Mail:
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@qq.com
#   SMTP_PASSWORD=your_authorization_code  # Use authorization code, not password
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#
# 163 Mail:
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USER=your_email@163.com
#   SMTP_PASSWORD=your_authorization_code
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=true
#
# Custom SMTP Server:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
# Use TLS (port 587) or SSL (port 465)
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Sender information
FROM_ADDRESS=agent@example.com
FROM_NAME=BESS Agent

# Data source API
BMS_API_URL=http://bms-api.example.com
BMS_API_KEY=your_bms_api_key_here

PCS_API_URL=http://pcs-api.example.com
PCS_API_KEY=your_pcs_api_key_here

EMS_API_URL=http://ems-api.example.com
EMS_API_KEY=your_ems_api_key_here

# MQTT/EMQX Configuration
# Broker URL: EMQX broker URL (default: mqtt://localhost:1883)
MQTT_BROKER_URL=mqtt://localhost:1883
# Username: Optional MQTT username for authentication
MQTT_USERNAME=
# Password: Optional MQTT password for authentication
MQTT_PASSWORD=
# Client ID: Unique client identifier
MQTT_CLIENT_ID=bess-agent-datacenter
# EMQX Dashboard: Admin credentials (default: admin/public)
EMQX_ADMIN_USER=admin
EMQX_ADMIN_PASSWORD=public
