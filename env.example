# BESS Agent environment variables configuration example
# Copy this file to .env and fill in actual values
# Note: .env file should not be committed to Git

# InfluxDB Configuration
# URL: InfluxDB server URL (default: http://localhost:8086)
INFLUXDB_URL=http://localhost:8086
# Token: API token for authentication (required)
# Get token from: docker logs bess-influxdb | grep -i token
# Or from InfluxDB UI: http://localhost:8086 → Data → Tokens
# Default (dev only): changeme
INFLUXDB_TOKEN=your_influxdb_token_here
# Organization: InfluxDB organization name (default: bess)
INFLUXDB_ORG=bess
# Bucket: InfluxDB bucket name for storing data (default: alarms)
INFLUXDB_BUCKET=alarms

# PostgreSQL
DB_USER=bess_agent
DB_PASSWORD=your_db_password_here

# Redis Configuration
# Host: Use "redis" when running in Docker, "localhost" when running locally
REDIS_HOST=localhost  # Use "redis" for Docker Compose, "localhost" for local development
REDIS_PORT=6379
REDIS_PASSWORD=changeme  # Default password, change in production
REDIS_DB=0

# LLM API configuration (choose one to use)
# Groq API (recommended for MVP, free)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (production environment)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Gemini API (free quota)
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face API (free quota)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Together AI API (free quota)
TOGETHER_API_KEY=your_together_api_key_here

# Grafana
GRAFANA_API_KEY=your_grafana_api_key_here

# Webhook Authentication (choose one method)
# Method 1: API Key authentication (recommended for simple setups)
WEBHOOK_API_KEY=your_webhook_api_key_here
# Method 2: Signature-based authentication (for Grafana webhooks)
# WEBHOOK_SECRET=your_webhook_secret_here

# Email service
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here

# Data source API
BMS_API_URL=http://bms-api.example.com
BMS_API_KEY=your_bms_api_key_here

PCS_API_URL=http://pcs-api.example.com
PCS_API_KEY=your_pcs_api_key_here

EMS_API_URL=http://ems-api.example.com
EMS_API_KEY=your_ems_api_key_here

# MQTT/EMQX Configuration
# Broker URL: EMQX broker URL (default: mqtt://localhost:1883)
MQTT_BROKER_URL=mqtt://localhost:1883
# Username: Optional MQTT username for authentication
MQTT_USERNAME=
# Password: Optional MQTT password for authentication
MQTT_PASSWORD=
# Client ID: Unique client identifier
MQTT_CLIENT_ID=bess-agent-datacenter
# EMQX Dashboard: Admin credentials (default: admin/public)
EMQX_ADMIN_USER=admin
EMQX_ADMIN_PASSWORD=public
