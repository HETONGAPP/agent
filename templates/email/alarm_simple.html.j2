<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: {% if severity == 'Critical' %}#dc3545{% elif severity == 'Warning' %}#ffc107{% else %}#17a2b8{% endif %};
            color: white;
            padding: 15px;
            border-radius: 5px;
        }
        .content {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>⚠️ BESS Alarm: {{ alarm_type }}</h2>
        <p>Severity: {{ severity }}</p>
    </div>

    <div class="content">
        <p><strong>Alarm ID:</strong> {{ alarm_id }}</p>
        <p><strong>Timestamp:</strong> {{ timestamp }}</p>
        <p><strong>Source:</strong> {{ alarm.source }}</p>
        {% if alarm.metadata.site_id %}
        <p><strong>Site:</strong> {{ alarm.metadata.site_id }}</p>
        {% endif %}
    </div>
</body>
</html>


