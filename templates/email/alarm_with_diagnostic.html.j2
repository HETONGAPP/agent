<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: {% if severity == 'Critical' %}#dc3545{% elif severity == 'Warning' %}#ffc107{% else %}#17a2b8{% endif %};
            color: white;
            padding: 20px;
            border-radius: 5px 5px 0 0;
        }
        .content {
            background-color: #f8f9fa;
            padding: 20px;
            border: 1px solid #dee2e6;
            border-top: none;
        }
        .section {
            margin-bottom: 20px;
        }
        .section h3 {
            color: #495057;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 5px;
        }
        .risk-level {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 3px;
            font-weight: bold;
        }
        .risk-high { background-color: #dc3545; color: white; }
        .risk-medium { background-color: #ffc107; color: #333; }
        .risk-low { background-color: #28a745; color: white; }
        ul, ol {
            margin-left: 20px;
        }
        .footer {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #dee2e6;
            font-size: 0.9em;
            color: #6c757d;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>⚠️ BESS Alarm Notification</h1>
        <p><strong>{{ alarm_type }}</strong> - {{ severity }}</p>
    </div>

    <div class="content">
        <div class="section">
            <h2>Alarm Information</h2>
            <p><strong>Alarm ID:</strong> {{ alarm_id }}</p>
            <p><strong>Alarm Type:</strong> {{ alarm_type }}</p>
            <p><strong>Severity:</strong> {{ severity }}</p>
            <p><strong>Timestamp:</strong> {{ timestamp }}</p>
            <p><strong>Source:</strong> {{ alarm.source }}</p>
            {% if alarm.metadata.site_id %}
            <p><strong>Site:</strong> {{ alarm.metadata.site_id }} ({{ alarm.metadata.site_name or '' }})</p>
            {% endif %}
        </div>

        {% if diagnostic %}
        <div class="section">
            <h2>Diagnostic Report</h2>
            <p><strong>Risk Level:</strong> 
                <span class="risk-level risk-{{ diagnostic.risk_level.lower() }}">
                    {{ diagnostic.risk_level }}
                </span>
            </p>
            <p><strong>Current Status:</strong> {{ diagnostic.current_status }}</p>

            {% if diagnostic.possible_causes %}
            <h3>Possible Causes</h3>
            <ol>
                {% for cause in diagnostic.possible_causes[:3] %}
                <li>{{ cause }}</li>
                {% endfor %}
            </ol>
            {% endif %}

            {% if diagnostic.recommended_actions %}
            <h3>Recommended Actions</h3>
            <ol>
                {% for action in diagnostic.recommended_actions[:5] %}
                <li>{{ action }}</li>
                {% endfor %}
            </ol>
            {% endif %}

            {% if diagnostic.references %}
            <h3>References</h3>
            <ul>
                {% for ref in diagnostic.references %}
                <li>{{ ref }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endif %}

        {% if device_data %}
        <div class="section">
            <h3>Device Data</h3>
            <ul>
                {% for key, value in device_data.items() %}
                {% if key not in ['labels', 'annotations', 'metadata'] %}
                <li><strong>{{ key }}:</strong> {{ value }}</li>
                {% endif %}
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if grafana_url %}
        <div class="section">
            <a href="{{ grafana_url }}" class="button">View in Grafana</a>
        </div>
        {% endif %}
    </div>

    <div class="footer">
        <p>This is an automated notification from BESS Alarm Diagnostic Agent.</p>
        <p>Generated at: {{ diagnostic.generated_at if diagnostic else timestamp }}</p>
    </div>
</body>
</html>


